<?xml version="1.0"?>
<robot name="four_wheel_car">

  <!-- ==================== 材质定义 ==================== -->
  <material name="body_blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="laser_gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="imu_red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>
  <material name="invisible">
    <color rgba="0 0 0 0"/>
  </material>

  <!-- ============================================================== -->
  <!-- base_footprint：地面投影点，z=0，用于导航定位基准              -->
  <!-- ============================================================== -->
  <link name="base_footprint">
    <visual>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="invisible"/>
    </visual>
  </link>

  <!-- ============================================================== -->
  <!-- base_link：车体几何中心                                        -->
  <!-- 离地间隙 0.11m + 车体半高 0.09m = 0.20m                       -->
  <!-- ============================================================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="1.0 0.6 0.18"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="body_blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="1.0 0.6 0.18"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.2" iyz="0.0"
               izz="0.25"/>
    </inertial>
  </link>

  <!-- base_footprint → base_link -->
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================== -->
  <!-- 四个轮子                                                       -->
  <!-- ============================================================== -->

  <!-- 左前轮 -->
  <link name="left_front_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.10" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.002"/>
    </inertial>
  </link>
  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel_link"/>
    <origin xyz="0.266 0.256 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 右前轮 -->
  <link name="right_front_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.10" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.002"/>
    </inertial>
  </link>
  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel_link"/>
    <origin xyz="0.266 -0.256 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 左后轮 -->
  <link name="left_rear_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.10" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.002"/>
    </inertial>
  </link>
  <joint name="left_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_rear_wheel_link"/>
    <!-- 修正：-0.269（轴距 0.535m） -->
    <origin xyz="-0.269 0.256 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 右后轮 -->
  <link name="right_rear_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.10" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.002"/>
    </inertial>
  </link>
  <joint name="right_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_rear_wheel_link"/>
    <!-- 修正：-0.269（轴距 0.535m） -->
    <origin xyz="-0.269 -0.256 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============================================================== -->
  <!-- 激光雷达                                                       -->
  <!-- 离地 0.36m → 相对 base_link: 0.36 - 0.20 = 0.16m              -->
  <!-- ============================================================== -->
  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="laser_gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.5 0 0.16" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================== -->
  <!-- IMU                                                            -->
  <!-- 离地 0.43m → 相对 base_link: 0.43 - 0.20 = 0.23m              -->
  <!-- ============================================================== -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.015"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="imu_red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.015"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.38 0 0.23" rpy="0 0 0"/>
  </joint>

</robot>
